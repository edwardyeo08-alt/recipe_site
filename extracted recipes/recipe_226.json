  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Heat a skillet over medium heat with cooking spray and saute peppers, onions, and garlic until soft."
    },
    {
      "step": 2,
      "title": "",
      "text": "Pour in crushed tomatoes and spices (cumin, paprika, salt, pepper) and let simmer for 5-8 minutes."
    },
    {
      "step": 3,
      "title": "",
      "text": "Use a spoon to make small wells in the sauce, then crack the eggs gently into each well."
    },
    {
      "step": 4,
      "title": "",
      "text": "Cover the skillet with a lid and cook on low heat for 5-7 minutes until the egg whites are set but yolks remain soft."
    },
    {
      "step": 5,
      "title": "",
      "text": "Sprinkle with fresh herbs and crumbled feta, and serve immediately with toasted crusty bread."
    }
  ],
