  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Heat a small deep pan over medium heat and lightly spray with cooking spray."
    },
    {
      "step": 2,
      "title": "",
      "text": "Add the tinned tomato & onion mix, garlic powder, salt, pepper, and chilli flakes (if using). Stir and bring to a simmer."
    },
    {
      "step": 3,
      "title": "",
      "text": "Add the spinach and let it wilt, allowing the sauce to reduce slightly."
    },
    {
      "step": 4,
      "title": "",
      "text": "Make two small wells in the sauce and crack in the eggs."
    },
    {
      "step": 5,
      "title": "",
      "text": "Cover with a lid and cook until the eggs reach your preferred doneness."
    },
    {
      "step": 6,
      "title": "",
      "text": "Remove from heat and sprinkle with crumbled feta."
    },
