  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Boil a large pot of salted water and cook the pasta according to package directions until al dente."
    },
    {
      "step": 2,
      "title": "",
      "text": "In a separate skillet, brown the protein with minced garlic and herbs over medium heat."
    },
    {
      "step": 3,
      "title": "",
      "text": "Stir in the sauce and diced vegetables, allowing the flavours to simmer together for 8-10 minutes."
    },
    {
      "step": 4,
      "title": "",
      "text": "Toss the drained pasta directly into the sauce so every strand is evenly coated."
    },
    {
      "step": 5,
      "title": "",
      "text": "Garnish with grated parmesan or fresh herbs and divide evenly into meal prep bowls."
    }
