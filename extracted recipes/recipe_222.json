  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Cut the chicken breasts into bite-sized pieces and season with curry powder, cumin, turmeric, and salt."
    },
    {
      "step": 2,
      "title": "",
      "text": "Heat a deep skillet or pot over medium heat. Sear the chicken pieces until lightly browned on all sides."
    },
    {
      "step": 3,
      "title": "",
      "text": "Add diced aromatics (onion, garlic, ginger) and saute until fragrant."
    },
    {
      "step": 4,
      "title": "",
      "text": "Stir in the tomato puree, light coconut milk or yoghurt, and simmer gently for 10-12 minutes until chicken is tender."
    },
    {
      "step": 5,
      "title": "",
      "text": "Serve hot over basmati rice or with warmed roti, garnished with fresh coriander."
    }
  ],
