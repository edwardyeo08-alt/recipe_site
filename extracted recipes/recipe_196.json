  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Heat a non-stick skillet over medium heat with cooking spray."
    },
    {
      "step": 2,
      "title": "",
      "text": "Cook the protein (lean beef or chicken strips) with Mexican spices (cumin, paprika, chilli flakes) until browned."
    },
    {
      "step": 3,
      "title": "",
      "text": "Warm the tortillas or wraps in a dry pan for 20 seconds each to make them pliable."
    },
    {
      "step": 4,
      "title": "",
      "text": "Layer each wrap with shredded lettuce, diced tomato, beans, cooked protein, and avocado or cottage cheese."
    },
    {
      "step": 5,
      "title": "",
      "text": "Tightly fold the sides in and roll up firmly. Slice in half and serve warm or wrap in foil for meal prep."
    }
  ],
