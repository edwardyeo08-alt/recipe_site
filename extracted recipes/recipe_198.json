  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Shape the lean mince or patties into even rounds, seasoning generously with salt, pepper, and garlic powder."
    },
    {
      "step": 2,
      "title": "",
      "text": "Preheat a heavy skillet or grill pan over medium-high heat with cooking spray."
    },
    {
      "step": 3,
      "title": "",
      "text": "Sear the burger patties for 4-5 minutes per side until cooked through and nicely charred."
    },
    {
      "step": 4,
      "title": "",
      "text": "Lightly toast the burger buns. If making homemade fries, air fry the potato wedges at 200°C for 18-20 minutes."
    },
    {
      "step": 5,
      "title": "",
      "text": "Assemble each burger with crisp lettuce, fresh tomato slices, sauce, and the cooked patties. Serve hot!"
    }
  ],
