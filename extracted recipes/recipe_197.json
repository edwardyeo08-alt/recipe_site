  "instructions": [
    {
      "step": 1,
      "title": "",
      "text": "Bring a pot of salted water to a rolling boil and cook the gnocchi for 2-3 minutes until they float, then drain."
    },
    {
      "step": 2,
      "title": "",
      "text": "Heat a skillet over medium heat with cooking spray. Brown the lean mince with diced onion and seasonings."
    },
    {
      "step": 3,
      "title": "",
      "text": "Pour in marinara sauce or passata and simmer on low for 5 minutes until rich and fragrant."
    },
    {
      "step": 4,
      "title": "",
      "text": "Gently fold the boiled gnocchi into the simmering beef sauce."
    },
    {
      "step": 5,
      "title": "",
      "text": "Top with cheese, cover with a lid for 2 minutes until melted and bubbly, then portion out."
    }
  ],
